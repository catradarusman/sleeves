# Base mainnet contracts
NEXT_PUBLIC_SOUND_CONTRACT=0x4cd9E570C36927820A18Eb30886a9B6aE9e2213b
NEXT_PUBLIC_SLEEVES_CONTRACT=0x4428be530724b5ee47e4cb0061f77024933a4dc3
NEXT_PUBLIC_CHAIN_ID=8453

# Base Sepolia (uncomment to develop against testnet)
# NEXT_PUBLIC_SOUND_CONTRACT=0x17269d671431dd39d7832b036b0a6bcc839e11a5
# NEXT_PUBLIC_SLEEVES_CONTRACT=0x4cd9e570c36927820a18eb30886a9b6ae9e2213b
# NEXT_PUBLIC_CHAIN_ID=84532

# Base RPC for contract reads AND wallet writes. Without it both fall back to
# mainnet.base.org, which rate-limits the holder multicall and makes holders
# render as "base didn't return who pressed it".
# NOTE: every NEXT_PUBLIC_* value ships to the browser. Restrict this key to
# your domains in the provider dashboard before using it in production.
NEXT_PUBLIC_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# NEXT_PUBLIC_RPC_URL_SEPOLIA=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# Ethereum mainnet RPC, used only to resolve ENS names for holders. Must send
# CORS headers: it is called from the browser.
NEXT_PUBLIC_ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# WalletConnect project id from cloud.walletconnect.com. Leave empty to offer
# only browser-extension and Coinbase wallets. Add your domains to the
# project's allowlist before shipping.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
